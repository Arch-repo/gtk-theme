/* GTK 3 & 4 Named Colors */
@define-color theme_fg_color {{foreground}};
@define-color theme_text_color {{foreground}};
@define-color theme_bg_color {{background}};
@define-color theme_base_color {{base}};
@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{selected_fg}};
@define-color borders {{rgba_border_0p35}};

@define-color insensitive_bg_color {{background}};
@define-color insensitive_fg_color {{muted}};
@define-color insensitive_base_color {{base_alt}};

@define-color theme_unfocused_fg_color {{foreground}};
@define-color theme_unfocused_text_color {{foreground}};
@define-color theme_unfocused_bg_color {{background}};
@define-color theme_unfocused_base_color {{base}};
@define-color theme_unfocused_selected_bg_color {{accent}};
@define-color theme_unfocused_selected_fg_color {{selected_fg}};
@define-color unfocused_insensitive_color {{muted}};
@define-color unfocused_borders {{rgba_border_0p35}};

@define-color wm_title {{foreground}};
@define-color wm_unfocused_title {{muted}};
@define-color wm_border {{background}};
@define-color wm_bg {{titlebar}};
@define-color wm_unfocused_bg {{titlebar_backdrop}};

/* Libadwaita / GTK4 compatibility colors */
@define-color accent_bg_color {{accent}};
@define-color accent_fg_color {{selected_fg}};
@define-color accent_color {{accent}};
@define-color destructive_bg_color {{red}};
@define-color destructive_fg_color {{selected_fg}};
@define-color success_bg_color {{green}};
@define-color success_fg_color {{selected_fg}};
@define-color warning_bg_color {{yellow}};
@define-color warning_fg_color {{selected_fg}};
@define-color error_bg_color {{red}};
@define-color error_fg_color {{selected_fg}};

@define-color window_bg_color {{rgba_background_window}};
@define-color window_fg_color {{foreground}};
@define-color view_bg_color {{rgba_base_view}};
@define-color view_fg_color {{foreground}};

@define-color headerbar_bg_color {{titlebar}};
@define-color headerbar_fg_color {{foreground}};
@define-color headerbar_border_color {{rgba_border_0p42}};
@define-color headerbar_backdrop_color {{titlebar_backdrop}};
@define-color headerbar_shade_color {{rgba_border_0p42}};

@define-color card_bg_color {{base}};
@define-color card_fg_color {{foreground}};
@define-color card_shade_color {{rgba_border_0p42}};

@define-color dialog_bg_color {{base_alt}};
@define-color dialog_fg_color {{foreground}};

@define-color popover_bg_color {{surface}};
@define-color popover_fg_color {{foreground}};

@define-color shade_color {{rgba_border_0p42}};
@define-color scrollbar_outline_color {{rgba_border_0p42}};
@define-color content_view_bg {{base}};
@define-color text_view_bg {{background}};

* {
  caret-color: @accent_color;
}

/* Role-based glass layer. Hyprland supplies the blur behind these alpha colors. */
.background,
window.background {
  background-color: {{rgba_background_window}};
  color: {{foreground}};
}

.view,
iconview,
treeview.view,
textview text,
.content-view {
  background-color: {{rgba_base_view}};
  color: {{foreground}};
}

.sidebar,
placessidebar.sidebar,
stacksidebar.sidebar,
stacksidebar.sidebar list {
  background-color: {{rgba_base_alt_sidebar}};
}

headerbar,
.titlebar,
.nemo-window .primary-toolbar,
.thunar toolbar {
  background-color: {{rgba_titlebar_header}};
  border-bottom: 1px solid {{rgba_border_0p42}};
}

popover > contents,
popover.background,
.background.popup {
  background-color: {{rgba_popover_popover}};
  border: 1px solid {{rgba_border_0p45}};
  border-radius: {{control_radius}}px;
  box-shadow: none;
  margin: 0;
}

/* File-manager chrome uses restrained separators instead of dark boxed panes. */
.nemo-window menubar,
.nemo-window .menubar,
.nemo-window statusbar,
.nemo-window .primary-toolbar {
  background-image: none;
  background-color: {{rgba_surface_0p18}};
  color: {{foreground}};
  border: none;
  box-shadow: none;
}
.nemo-window .sidebar,
.nemo-window .sidebar .frame,
.nemo-window .sidebar scrolledwindow,
.nemo-window scrolledwindow.frame,
.nemo-window .standard-view.frame {
  border: none;
  box-shadow: none;
}

/* The full historical theme paints the notebook behind Nemo's icon view.
 * An alpha view alone cannot reveal the compositor through that opaque parent. */
.nemo-window notebook,
.nemo-window notebook > stack,
.nemo-window .nemo-window-pane {
  background-image: none;
  background-color: transparent;
  border: none;
  box-shadow: none;
}

dialog.background,
messagedialog.background,
.dialog-content {
  background-color: {{rgba_base_alt_dialog}};
  box-shadow: none;
}

.nemo-window .view,
.nemo-window iconview,
.nautilus-window .view,
.nautilus-window gridview,
.nautilus-window listview,
.thunar .view,
.thunar iconview,
filechooser .view {
  background-color: {{rgba_base_view}};
}

.nemo-window .view:not(:selected),
.thunar .standard-view.frame .view:not(:selected),
.thunar .sidebar .view:not(:selected),
filechooser stack.view,
filechooser stack.view scrolledwindow,
filechooser stack.view scrolledwindow list {
  background-color: transparent;
}

.view:selected,
treeview.view:selected,
row:selected {
  background-color: {{accent}};
  color: {{selected_fg}};
}

scale trough,
scale > trough {
  background-image: none;
  background-color: {{rgba_foreground_0p22}};
  border: none;
  border-radius: 999px;
  min-height: 3px;
  min-width: 3px;
}

scale highlight,
scale > trough > highlight {
  background-image: none;
  background-color: {{accent}};
  border-radius: 999px;
}

scale slider,
scale > trough > slider {
  background-image: none;
  background-color: {{accent}};
  color: {{selected_fg}};
  min-height: 16px;
  min-width: 16px;
  margin: -7px;
  border: none;
  border-radius: 999px;
  box-shadow: none;
}

scale slider:hover,
scale slider:focus,
scale slider:active,
scale > trough > slider:hover,
scale > trough > slider:focus,
scale > trough > slider:active {
  background-image: none;
  background-color: {{select}};
  box-shadow: 0 0 0 2px {{rgba_accent_0p18}};
}
